[node name="DriftersProject" parent="UI/Menus/ProjectMenu/ScrollContainer/VBoxContainer" unique_id=1667972201 instance=ExtResource("8_h6qgc")]
layout_mode = 2
titleText = "DRIFTERS"
projectImage = ExtResource("9_pcnie")
description = "can't decide what game to play with friends?
no problem.

in DRIFTERS each character fights with a different genre. putting shooters, fighters, soulslike and strategy all on the same stage.
now everyone can play the genre of game they prefer."

[node name="CCProject" parent="UI/Menus/ProjectMenu/ScrollContainer/VBoxContainer" unique_id=722594258 instance=ExtResource("8_h6qgc")]
layout_mode = 2
titleText = "CHARACTER CREATOR"
titleSize = 20
projectImage = ExtResource("10_laq7h")
description = "tool being made for the DRIFTERS project making character modeling easy.

select body part, facial features, clothes and edit textures directly to create characters quickly for games, art, animation or anything else."

[node name="ShaderProject" parent="UI/Menus/ProjectMenu/ScrollContainer/VBoxContainer" unique_id=1686781053 instance=ExtResource("8_h6qgc")]
layout_mode = 2
titleText = "HLSL DEMO"
status = 2
projectImage = ExtResource("11_q8kmj")
description = "a simple project I did to try out Unity HLSL shaders.

made a simple water shader, swaying grass and sand that leaves an imprint when walked over by the player. with all calculations done on the GPU for optimal performance."

[node name="OvertureProject" parent="UI/Menus/ProjectMenu/ScrollContainer/VBoxContainer" unique_id=1486904060 instance=ExtResource("8_h6qgc")]
layout_mode = 2
titleText = "ENCORE OVERTURE"
titleSize = 22
status = 1
projectImage = ExtResource("12_lu501")
description = "ENCORE OVERTURE is both a strategy game and a 3D fighting game designed by my younger brother and similar to Guilty Gear 2.
the player has to move their soldiers around on the map to claim control points and fight with their own character to defeat enemy soldiers or other players."

[node name="VRDemoProject" parent="UI/Menus/ProjectMenu/ScrollContainer/VBoxContainer" unique_id=1841197110 instance=ExtResource("8_h6qgc")]
layout_mode = 2
titleText = "VR DEMO"
status = 3
projectImage = ExtResource("13_uaysb")
description = "my first major project, it didn't have a focus and was mostly just to try making different things, all in VR.

it hade guns, climbing, enemies and vehicles but without a goal it became endless so I stopped."

